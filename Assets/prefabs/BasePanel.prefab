  languageTexts:
  - language: 10
    text: Play Now
  - language: 0
    text: Speel Nou
  - language: 1
    text: "\u0627\u0644\u0639\u0628 \u0627\u0644\u0622\u0646"
  - language: 2
    text: Jokatu orain
  - language: 3
    text: "\u0413\u0443\u043B\u044F\u0446\u044C \u0437\u0430\u0440\u0430\u0437"
  - language: 4
    text: "\u0418\u0433\u0440\u0430\u0439 \u0441\u0435\u0433\u0430"
  - language: 5
    text: Juga ara
  - language: 6
    text: "\u7ACB\u5373\u5F00\u59CB"
  - language: 7
    text: "Hr\xE1t hned"
  - language: 8
    text: Spil Nu
  - language: 9
    text: Speel nu
  - language: 11
    text: "M\xE4ngi n\xFC\xFCd"
  - language: 12
    text: "Sp\xE6l n\xFA"
  - language: 13
    text: Pelaa nyt
  - language: 14
    text: Jouer
  - language: 15
    text: Jetzt spielen
  - language: 16
    text: "\u03A0\u03B1\u03AF\u03BE\u03B5 \u03C4\u03CE\u03C1\u03B1"
  - language: 17
    text: "\u05E9\u05D7\u05E7 \u05E2\u05DB\u05E9\u05D9\u05D5"
  - language: 18
    text: "J\xE1tssz most"
  - language: 19
    text: "Spila n\xFAna"
  - language: 20
    text: Main Sekarang
  - language: 21
    text: Gioca Ora
  - language: 22
    text: "\u4ECA\u3059\u3050\u30D7\u30EC\u30A4"
  - language: 23
    text: "\uC9C0\uAE08 \uD50C\uB808\uC774"
  - language: 24
    text: "Sp\u0113l\u0113t tagad"
  - language: 25
    text: "\u017Daisti dabar"
  - language: 26
    text: "Spill n\xE5"
  - language: 27
    text: Graj teraz
  - language: 28
    text: Jogar
  - language: 29
    text: "Joac\u0103 Acum"
  - language: 30
    text: "\u0418\u0433\u0440\u0430\u0442\u044C"
  - language: 31
    text: Igraj Sad
  - language: 32
    text: "Hra\u0165 teraz"
  - language: 33
    text: Igraj zdaj
  - language: 34
    text: Jugar ahora
  - language: 35
    text: Spela nu
  - language: 36
    text: "\u0E40\u0E25\u0E48\u0E19\u0E40\u0E25\u0E22"
  - language: 37
    text: Hemen Oyna
  - language: 38
    text: "\u0413\u0440\u0430\u0442\u0438 \u0437\u0430\u0440\u0430\u0437"
  - language: 39
    text: "Ch\u01A1i Ngay"
  - language: 40
